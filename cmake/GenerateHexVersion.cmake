## Determines the Hex version (name of the closest reachable git tag) and the
## current git commit (short hash), and writes them into HEX_OUTPUT_FILE as the
## HEX_VERSION and HEX_GIT_COMMIT macros that common/hex-version.cpp includes.
##
## Invoked in script mode (cmake -P) from a custom target that runs on every
## build, not only on reconfiguration, so the reported version and commit always
## match the current checkout. Both macros fall back to "unknown" outside a git
## checkout (e.g. a source tarball) or when no tag is reachable.
##
## Expected variables (passed with -D):
##   HEX_SOURCE_DIR      the git working tree to query
##   HEX_GIT_EXECUTABLE  path to git, or empty if it was not found
##   HEX_OUTPUT_FILE     the header to (re)write

set(HEX_VERSION "unknown")
set(HEX_GIT_COMMIT "unknown")

if(HEX_GIT_EXECUTABLE)

    execute_process(
        COMMAND "${HEX_GIT_EXECUTABLE}" describe --tags --abbrev=0
        WORKING_DIRECTORY "${HEX_SOURCE_DIR}"
        RESULT_VARIABLE HEX_GIT_RESULT
        OUTPUT_VARIABLE HEX_GIT_OUTPUT
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if(HEX_GIT_RESULT EQUAL 0 AND HEX_GIT_OUTPUT)
        set(HEX_VERSION "${HEX_GIT_OUTPUT}")
    endif()

    execute_process(
        COMMAND "${HEX_GIT_EXECUTABLE}" rev-parse --short HEAD
        WORKING_DIRECTORY "${HEX_SOURCE_DIR}"
        RESULT_VARIABLE HEX_GIT_RESULT
        OUTPUT_VARIABLE HEX_GIT_OUTPUT
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if(HEX_GIT_RESULT EQUAL 0 AND HEX_GIT_OUTPUT)
        set(HEX_GIT_COMMIT "${HEX_GIT_OUTPUT}")
    endif()

endif()

set(HEX_VERSION_HEADER_CONTENT
"// Generated by cmake/GenerateHexVersion.cmake at build time -- do not edit.
#pragma once
#define HEX_VERSION \"${HEX_VERSION}\"
#define HEX_GIT_COMMIT \"${HEX_GIT_COMMIT}\"
")

# rewrite the header only when its content actually changed, so hex-version.cpp
# is not recompiled on every single build, only when the version or commit moved
set(HEX_VERSION_HEADER_OLD_CONTENT "")
if(EXISTS "${HEX_OUTPUT_FILE}")
    file(READ "${HEX_OUTPUT_FILE}" HEX_VERSION_HEADER_OLD_CONTENT)
endif()

if(NOT HEX_VERSION_HEADER_OLD_CONTENT STREQUAL HEX_VERSION_HEADER_CONTENT)
    file(WRITE "${HEX_OUTPUT_FILE}" "${HEX_VERSION_HEADER_CONTENT}")
endif()
